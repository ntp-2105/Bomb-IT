                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "tick": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "version",
            "type",
            "gameId",
            "sequence",
            "serverTimeMs",
