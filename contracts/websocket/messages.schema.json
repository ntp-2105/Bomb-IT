          "required": [
            "version",
            "type",
            "requestId",
            "payload"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "type": {
              "const": "JOIN_GAME"
            },
            "requestId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "payload": {
              "type": "object",
              "required": [
                "gameId"
              ],
              "properties": {
                "gameId": {
                  "$ref": "https://bomb-it.example/contracts/v1/game/state.schema.json#/$defs/GameId"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "version",
            "type",
            "requestId",
            "payload"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "type": {
              "const": "LEAVE_GAME"
            },
            "requestId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "payload": {
              "type": "object",
              "required": [],
              "properties": {},
              "additionalProperties": false
            }
          },
          "additionalProperties": false
