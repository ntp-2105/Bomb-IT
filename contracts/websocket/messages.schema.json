                    "UP",
                    "DOWN",
                    "LEFT",
                    "RIGHT",
                    null
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "version",
            "type",
            "requestId",
            "payload"
          ],
          "properties": {
            "version": {
              "const": 1
            },
            "type": {
              "const": "PLACE_BOMB"
            },
            "requestId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "payload": {
              "type": "object",
              "required": [],
              "properties": {},
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "version",
            "type",
            "requestId",
            "payload"
          ],
          "properties": {
